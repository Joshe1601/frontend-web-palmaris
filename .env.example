# Proyecto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
# anon key o publishable key (sb_publishable_...), cualquiera de los dos nombres
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# SOLO servidor (API routes). Nunca con prefijo NEXT_PUBLIC_.
# Se usa unicamente para crear usuarios de Auth al dar de alta choferes.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# SOLO servidor. Trazado por calles (https://openrouteservice.org -> Dashboard -> Request a token).
# Opcional: si falta, las rutas se calculan y dibujan en línea recta.
OPENROUTESERVICE_API_KEY=<token de OpenRouteService>
